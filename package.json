{
  "name": "santo-salto-store",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:seed-sql": "node scripts/generate-seed.ts > supabase/seed.sql",
    "validate": "pnpm check && pnpm test && pnpm build",
    "astro": "astro",
    "db:seed": "node --env-file=.env scripts/seed-db.ts",
    "db:make-admin": "node --env-file=.env scripts/make-admin.ts"
  },
  "dependencies": {
    "@astrojs/vercel": "^10.0.6",
    "@nanostores/persistent": "^1.3.4",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "~6.4.8",
    "nanostores": "^1.3.0",
    "qrcode": "^1.5.4",
    "stripe": "^23.2.0",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.1.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
