---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pixCode = '00020101021226360014BR.GOV.BCB.PIX0114561593880001225204000053039865802BR5924SANTO SALTO COM VAR CALC6007JUNDIAI62070503***63049207';
---

<BaseLayout title="Pagamento Pix — Santo Salto" description="Pague com Pix na Santo Salto. Rápido, seguro e sem taxas.">
  <section class="pt-32 pb-20">
    <div class="container-narrow max-w-xl mx-auto text-center">

      <p class="eyebrow mb-4">Pagamento</p>
      <h1 class="display-md mb-4">Pague com Pix.</h1>
      <p class="text-mocha leading-relaxed mb-12">
        Rápido, seguro e sem taxas adicionais.<br/>
        Após o pagamento, envie o comprovativo para o nosso WhatsApp.
      </p>

      <!-- QR Code -->
      <div class="flex flex-col items-center gap-6 mb-10">
        <div class="p-6 bg-white inline-block shadow-lg" style="border: 2px solid rgba(192,57,43,0.15); border-radius: 4px;">
          <img src="/pix-qr.png" alt="QR Code Pix — Santo Salto" class="w-64 h-64 md:w-80 md:h-80" />
        </div>

        <div class="text-center space-y-1">
          <p class="eyebrow text-xs" style="color: #C0392B;">Beneficiário</p>
          <p class="font-display text-lg text-ink">Santo Salto</p>
          <p class="text-sm text-mocha">CNPJ: 56.159.388/0001-22</p>
        </div>
      </div>

      <!-- Chave Pix copiável -->
      <div class="mb-10">
        <p class="eyebrow text-xs mb-3" style="color: #C0392B;">Chave Pix (CNPJ)</p>
        <div class="flex items-center gap-3 bg-cream px-5 py-4 justify-between max-w-sm mx-auto">
          <span id="pix-key" class="text-sm font-mono text-ink">56.159.388/0001-22</span>
          <button
            id="copy-btn"
            onclick="navigator.clipboard.writeText('56159388000122').then(() => { document.getElementById('copy-btn').textContent = 'Copiado ✓'; setTimeout(() => document.getElementById('copy-btn').textContent = 'Copiar', 2000); })"
            class="eyebrow text-xs shrink-0 hover:opacity-70 transition-opacity"
            style="color: #C0392B;"
          >
            Copiar
          </button>
        </div>
      </div>

      <!-- Código completo copiável -->
      <div class="mb-12">
        <p class="eyebrow text-xs mb-3" style="color: #C0392B;">Pix Copia e Cola</p>
        <div class="bg-cream px-5 py-4 max-w-sm mx-auto text-left">
          <p class="text-xs font-mono text-mocha break-all leading-relaxed">{pixCode}</p>
          <button
            onclick={`navigator.clipboard.writeText('${pixCode}').then(() => { this.textContent = 'Copiado ✓'; setTimeout(() => this.textContent = 'Copiar código', 2000); })`}
            class="eyebrow text-xs mt-3 block hover:opacity-70 transition-opacity"
            style="color: #C0392B;"
          >
            Copiar código
          </button>
        </div>
      </div>

      <!-- Passos -->
      <div class="text-left bg-cream p-8 mb-10 space-y-4">
        <p class="eyebrow mb-4" style="color: #C0392B;">Como pagar</p>
        {[
          'Abra o app do seu banco',
          'Escolha pagar com Pix — QR Code ou Copia e Cola',
          'Aponte a câmera para o QR Code ou cole o código',
          'Confirme os dados: Santo Salto · CNPJ 56.159.388/0001-22',
          'Após o pagamento, envie o comprovativo para o nosso WhatsApp',
        ].map((step, i) => (
          <div class="flex gap-4 items-start">
            <span class="font-display text-2xl leading-none shrink-0" style="color: #C0392B;">{String(i + 1).padStart(2, '0')}</span>
            <p class="text-mocha leading-relaxed text-sm pt-1">{step}</p>
          </div>
        ))}
      </div>

      <!-- WhatsApp CTA -->
      <a
        href="https://wa.me/5511910828374"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary inline-flex items-center gap-3"
        style="background-color: #25D366; color: #fff;"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Enviar comprovativo no WhatsApp
      </a>

    </div>
  </section>
</BaseLayout>
