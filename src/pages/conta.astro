---
import BaseLayout from '../layouts/BaseLayout.astro';
import { isSupabaseConfigured } from '../lib/env';
import { supabaseForRequest } from '../lib/server/supabase';
import { formatBRL } from '../lib/pricing';
import { loginIdentifierToEmail } from '../lib/server/auth';
import { ORDER_STATUS_LABEL, type OrderStatus } from '../lib/types';

const configured = isSupabaseConfigured();
let error = '';
let info = '';
let user = Astro.locals.user ?? null;

if (configured && Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = String(fd.get('action') ?? '');
  const sb = supabaseForRequest(Astro.request, Astro.cookies);
  const email = String(fd.get('email') ?? '').trim();
  const password = String(fd.get('password') ?? '');
  if (action === 'logout') {
    await sb.auth.signOut();
    return Astro.redirect('/conta');
  }
  if (action === 'login') {
    const { data, error: e } = await sb.auth.signInWithPassword({ email: loginIdentifierToEmail(email), password });
    if (e) error = 'E-mail ou palavra-passe incorretos.';
    else user = data.user;
  }
  if (action === 'signup') {
    const { data, error: e } = await sb.auth.signUp({ email, password, options: { data: { full_name: String(fd.get('name') ?? '') }, emailRedirectTo: `${Astro.url.origin}/conta` } });
    if (e) error = e.message;
    else if (data.session) user = data.user;
    else info = 'Conta criada! Confirme o seu e-mail para entrar.';
  }
}

interface OrderLite { id: string; number: number; status: OrderStatus; total: number; created_at: string; access_token: string }
let orders: OrderLite[] = [];
let isAdmin = false;
if (configured && user) {
  const { data: profile } = await supabaseForRequest(Astro.request, Astro.cookies).from('profiles').select('role').eq('id', user.id).maybeSingle();
  isAdmin = profile?.role === 'admin';
  const { data } = await supabaseForRequest(Astro.request, Astro.cookies).from('orders').select('id, number, status, total, created_at, access_token').order('created_at', { ascending: false });
  orders = (data ?? []) as OrderLite[];
}
---

<BaseLayout title="Minha conta" noIndex>
  <section class="container-site pt-14 md:pt-20 pb-16 min-h-[70vh]">
    {user ? (
      <div class="max-w-4xl">
        <div class="flex flex-wrap items-end justify-between gap-4 mb-12">
          <div><p class="eyebrow mb-3">Bem-vinda de volta</p><h1 class="display-lg">{user.email?.endsWith('@santosalto.admin') ? user.email.split('@')[0] : user.email}</h1></div>
          <div class="flex gap-3">
            {isAdmin && <a href="/admin" class="btn-gold" data-astro-reload>Painel de gestão</a>}
            <form method="post" data-astro-reload><input type="hidden" name="action" value="logout" /><button class="btn-ghost text-ink">Sair</button></form>
          </div>
        </div>
        <h2 class="display-md mb-6">As suas encomendas</h2>
        {orders.length === 0 ? <p class="text-mocha">Ainda não tem encomendas associadas a esta conta.</p> : (
          <ul class="divide-y divide-taupe/20 bg-white rounded-[28px] shadow-soft">
            {orders.map((o) => (
              <li><a href={`/pedido/${o.id}?t=${o.access_token}`} class="flex items-center justify-between gap-4 p-5 hover:bg-cream/60 transition">
                <span><span class="font-display text-xl text-ink">#{o.number}</span><span class="block text-xs text-mocha">{new Date(o.created_at).toLocaleDateString('pt-BR')}</span></span>
                <span class="chip bg-blush text-cocoa">{ORDER_STATUS_LABEL[o.status]}</span>
                <span class="text-sm">{formatBRL(Number(o.total))}</span>
              </a></li>
            ))}
          </ul>
        )}
      </div>
    ) : (
      <div class="grid lg:grid-cols-2 gap-10 max-w-5xl mx-auto">
        <div>
          <p class="eyebrow mb-3">Minha conta</p>
          <h1 class="display-lg mb-6">Entre no seu <em class="text-brand">universo</em> Santo Salto.</h1>
          <p class="text-mocha mb-6">Acompanhe encomendas, guarde moradas e receba lançamentos antes de todas.</p>
          {!configured && <p class="rounded-2xl bg-blush px-4 py-3 text-sm text-cocoa">As contas ficam disponíveis assim que a base de dados estiver ligada.</p>}
          {error && <p class="rounded-2xl bg-blush px-4 py-3 text-sm text-cocoa" role="alert">{error}</p>}
          {info && <p class="rounded-2xl bg-cream px-4 py-3 text-sm text-ink" role="status">{info}</p>}
        </div>
        <div class="bg-white rounded-[32px] shadow-soft p-8" data-auth>
          <div class="flex gap-2 mb-8 p-1 rounded-full bg-cream">
            <button type="button" class="flex-1 rounded-full py-2.5 text-[11px] uppercase tracking-[0.2em] bg-ink text-bone" data-tab="login">Entrar</button>
            <button type="button" class="flex-1 rounded-full py-2.5 text-[11px] uppercase tracking-[0.2em] text-ink" data-tab="signup">Criar conta</button>
          </div>
          <form method="post" class="space-y-4" data-astro-reload>
            <input type="hidden" name="action" value="login" data-action />
            <label class="field hidden" data-signup-only><span>Nome</span><input name="name" autocomplete="name" /></label>
            <label class="field"><span>E-mail ou utilizador</span><input name="email" type="text" required autocomplete="username" /></label>
            <label class="field"><span>Palavra-passe</span><input name="password" type="password" required minlength="8" autocomplete="current-password" /></label>
            <button class="btn-primary w-full" disabled={!configured} data-auth-submit>Entrar</button>
          </form>
        </div>
      </div>
    )}
  </section>
</BaseLayout>
<script>
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-auth]');
    if (!root) return;
    root.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((t) => t.addEventListener('click', () => {
      const signup = t.dataset.tab === 'signup';
      root.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => { const on = b === t; b.classList.toggle('bg-ink', on); b.classList.toggle('text-bone', on); b.classList.toggle('text-ink', !on); });
      root.querySelector<HTMLInputElement>('[data-action]')!.value = signup ? 'signup' : 'login';
      root.querySelector('[data-signup-only]')!.classList.toggle('hidden', !signup);
      root.querySelector('[data-auth-submit]')!.textContent = signup ? 'Criar conta' : 'Entrar';
    }));
  });
</script>
