---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProducts } from '../lib/server/catalog';
const products = await getProducts();
---

<BaseLayout title="Lista de desejos" description="Os seus favoritos Santo Salto." noIndex>
  <section class="container-site pt-14 md:pt-20 pb-16 min-h-[70vh]">
    <p class="eyebrow mb-3">Favoritos</p>
    <h1 class="display-xl mb-12">Os seus <em class="text-brand">desejos.</em></h1>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-12 md:gap-x-6" data-wish-grid>
      {products.map((p, i) => <div class="hidden" data-wish-item={p.slug}><ProductCard product={p} index={i} /></div>)}
    </div>
    <div class="hidden text-center py-20 rounded-[32px] border border-dashed border-taupe/40" data-wish-empty>
      <p class="script text-6xl text-gold mb-3">Ainda nada</p>
      <p class="text-mocha mb-8">Toque no ♥ de qualquer peça para a guardar aqui.</p>
      <a href="/colecao/novidades" class="btn-primary">Descobrir novidades</a>
    </div>
  </section>
</BaseLayout>
<script>
  import { wishlist } from '../stores/wishlist';
  const render = (): void => {
    const list = wishlist.get();
    let n = 0;
    document.querySelectorAll<HTMLElement>('[data-wish-item]').forEach((el) => { const on = list.includes(el.dataset.wishItem ?? ''); el.classList.toggle('hidden', !on); if (on) n++; });
    document.querySelector('[data-wish-empty]')?.classList.toggle('hidden', n > 0);
  };
  wishlist.subscribe(render);
  document.addEventListener('astro:page-load', render);
</script>
