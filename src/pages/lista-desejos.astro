---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Lista de Desejos — AURÉLIA" description="A sua lista de desejos AURÉLIA." noIndex>
  <section class="pt-32 pb-20 bg-bone min-h-[70vh]">
    <div class="container-aurelia text-center">
      <p class="eyebrow mb-3">Favoritos</p>
      <h1 class="display-md mb-6">Lista de desejos.</h1>
      <p class="text-mocha max-w-md mx-auto mb-10">Guarde aqui os pares que pretende para mais tarde.</p>
      <div class="border border-dashed border-taupe/40 py-20 max-w-2xl mx-auto">
        <p class="text-mocha mb-6">A sua lista está vazia.</p>
        <a href="/colecoes" class="btn-primary">Descobrir coleções</a>
      </div>
    </div>
  </section>
</BaseLayout>
