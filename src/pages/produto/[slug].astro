---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCategories, getProductBySlug, getProducts, getSettings } from '../../lib/server/catalog';
import { formatBRL, installments } from '../../lib/pricing';
import { BADGE_LABEL } from '../../lib/types';

const { slug = '' } = Astro.params;
const product = await getProductBySlug(slug);
if (!product) return Astro.rewrite('/404');

const [all, categories, settings] = await Promise.all([getProducts(), getCategories(), getSettings()]);
const related = all.filter((p) => p.id !== product.id && (p.category === product.category || p.collection === product.collection)).slice(0, 4);
const categoryLabel = categories.find((c) => c.slug === product.category)?.label ?? product.category;
const hasDiscount = product.oldPrice !== null && product.oldPrice > product.price;
const pixPrice = product.price * (1 - settings.pixDiscountPercent / 100);
const heelCm = product.heelHeight ? parseFloat(product.heelHeight) : null;
const cartPayload = { productId: product.id, slug: product.slug, name: product.name, price: product.price, image: product.images[0]?.src ?? '' };
const waText = encodeURIComponent(`Olá! Tenho uma dúvida sobre o ${product.name} (${Astro.url.href})`);

const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Product', name: product.name, description: product.shortDescription,
  image: product.images.map((i) => i.src), brand: { '@type': 'Brand', name: 'Santo Salto' },
  offers: { '@type': 'Offer', priceCurrency: 'BRL', price: product.price, availability: product.sizes.some((s) => s.stock > 0) ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock' },
};
---

<BaseLayout title={product.name} description={product.shortDescription} image={product.images[0]?.src}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="container-site pt-6">
    <nav class="text-[11px] uppercase tracking-[0.18em] text-mocha flex flex-wrap items-center gap-2" aria-label="Breadcrumb">
      <a href="/" class="link-underline">Início</a><span class="text-gold">/</span>
      <a href={`/colecao/${product.category}`} class="link-underline">{categoryLabel}</a><span class="text-gold">/</span>
      <span class="text-ink">{product.name}</span>
    </nav>
  </div>

  <section class="container-site py-8 lg:py-12">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16">
      <!-- Galeria -->
      <div class="lg:col-span-7">
        <div class="lg:hidden -mx-4 flex overflow-x-auto snap-x snap-mandatory no-scrollbar gap-2 px-4" data-mobile-gallery>
          {product.images.map((img, i) => (
            <img src={img.src} alt={img.alt} class="snap-center shrink-0 w-[88vw] aspect-[4/5] object-cover rounded-[24px] bg-cream" loading={i === 0 ? 'eager' : 'lazy'} transition:name={i === 0 ? `product-${product.slug}` : undefined} />
          ))}
        </div>
        <div class="hidden lg:grid grid-cols-2 gap-3">
          {product.images.map((img, i) => (
            <button type="button" class:list={['zoom relative overflow-hidden rounded-[24px] bg-cream cursor-zoom-in', i === 0 ? 'col-span-2 aspect-[5/5]' : 'aspect-[4/5]']} data-zoom={i} data-cursor="Zoom">
              <img src={img.src} alt={img.alt} loading={i === 0 ? 'eager' : 'lazy'} class="absolute inset-0 w-full h-full object-cover transition-transform duration-300" transition:name={i === 0 ? `product-${product.slug}` : undefined} />
            </button>
          ))}
        </div>
      </div>

      <!-- Info -->
      <div class="lg:col-span-5 lg:sticky lg:top-28 lg:self-start">
        <div class="flex flex-wrap gap-2 mb-5">
          {product.badges.map((b) => <span class:list={['chip', b === 'best-seller' ? 'bg-gold text-night' : 'bg-ink text-bone']}>{BADGE_LABEL[b]}</span>)}
          {hasDiscount && <span class="chip bg-brand text-bone">Promoção</span>}
        </div>
        <h1 class="display-lg mb-3">{product.name}</h1>
        <p class="text-mocha mb-6 text-pretty">{product.shortDescription}</p>

        <div class="flex items-baseline gap-3 mb-1">
          <span class="font-display text-4xl text-ink">{formatBRL(product.price)}</span>
          {hasDiscount && product.oldPrice && <span class="text-taupe line-through">{formatBRL(product.oldPrice)}</span>}
        </div>
        <p class="text-sm text-mocha">{installments(product.price)} · <strong class="text-brand">{formatBRL(pixPrice)} no Pix</strong></p>

        <form id="buy-form" class="mt-8 space-y-7" data-product={JSON.stringify(cartPayload)}>
          {product.colors.length > 0 && (
            <fieldset>
              <legend class="eyebrow mb-3">Cor · <span data-color-label class="text-ink normal-case tracking-normal">{product.colors[0]?.name}</span></legend>
              <div class="flex gap-3">
                {product.colors.map((c, i) => (
                  <label class="relative cursor-pointer">
                    <input type="radio" name="color" value={c.name} checked={i === 0} class="peer sr-only" />
                    <span class="block w-10 h-10 rounded-full ring-1 ring-taupe/40 peer-checked:ring-2 peer-checked:ring-brand peer-checked:ring-offset-2 ring-offset-bone transition" style={`background:${c.hex}`} title={c.name}></span>
                  </label>
                ))}
              </div>
            </fieldset>
          )}

          <fieldset>
            <div class="flex justify-between items-center mb-3">
              <legend class="eyebrow">Tamanho</legend>
              <button type="button" class="text-[11px] uppercase tracking-[0.18em] text-mocha link-underline" data-open-size-guide>Descubra o seu número</button>
            </div>
            <div class="grid grid-cols-5 sm:grid-cols-6 gap-2">
              {product.sizes.map((s) => (
                <label class:list={['relative', { 'pointer-events-none': s.stock === 0 }]}>
                  <input type="radio" name="size" value={s.label} disabled={s.stock === 0} class="peer sr-only" data-stock={s.stock} />
                  <span class="h-12 grid place-items-center rounded-2xl border border-taupe/40 text-sm cursor-pointer transition peer-checked:bg-ink peer-checked:text-bone peer-checked:border-ink hover:border-ink peer-disabled:opacity-35 peer-disabled:line-through">{s.label}</span>
                </label>
              ))}
            </div>
            <p data-stock-msg class="text-xs text-brand mt-2 min-h-4" aria-live="polite"></p>
          </fieldset>

          {heelCm !== null && (
            <div class="rounded-2xl bg-cream p-4 flex items-center gap-5">
              <div class="relative w-full h-2 rounded-full bg-sand">
                <span class="absolute inset-y-0 left-0 rounded-full bg-gradient-to-r from-rose to-brand" style={`width:${Math.min(100, (heelCm / 12) * 100)}%`}></span>
                <span class="absolute -top-5 text-[10px] text-mocha" style={`left:calc(${Math.min(100, (heelCm / 12) * 100)}% - 12px)`}>{product.heelHeight}</span>
              </div>
              <p class="text-[10px] uppercase tracking-[0.18em] text-mocha whitespace-nowrap">{heelCm <= 4 ? 'Conforto total' : heelCm <= 7 ? 'Médio, dia todo' : 'Alto, poder'}</p>
            </div>
          )}

          <div class="flex gap-3">
            <button type="submit" class="btn-primary flex-1" data-add-btn>Adicionar à sacola</button>
            <button type="button" class="wish-btn w-[58px] rounded-full border border-taupe/40 grid place-items-center text-ink hover:text-brand transition" data-wish={product.slug} aria-pressed="false" aria-label="Favoritos">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20.8 4.6a5.5 5.5 0 00-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 00-7.8 7.8L12 21.2l8.8-8.8a5.5 5.5 0 000-7.8z"/></svg>
            </button>
          </div>
          <a href={`https://wa.me/${settings.whatsapp}?text=${waText}`} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 text-[11px] uppercase tracking-[0.2em] text-mocha hover:text-brand transition">✦ Dúvidas? Fale com uma consultora</a>
        </form>

        <div class="mt-10 divide-y divide-taupe/25 border-y border-taupe/25">
          <details class="group py-5" open>
            <summary class="flex justify-between cursor-pointer list-none eyebrow !text-ink">Descrição <span class="group-open:rotate-45 transition">+</span></summary>
            <p class="mt-4 text-mocha leading-relaxed text-pretty">{product.description}</p>
          </details>
          <details class="group py-5">
            <summary class="flex justify-between cursor-pointer list-none eyebrow !text-ink">Detalhes & materiais <span class="group-open:rotate-45 transition">+</span></summary>
            <ul class="mt-4 space-y-2 text-mocha text-sm">{product.details.map((d) => <li class="flex gap-3"><span class="text-gold">✦</span>{d}</li>)}</ul>
            <p class="mt-4 text-sm text-mocha"><strong class="text-ink">Materiais:</strong> {product.materials}</p>
            <p class="text-sm text-mocha"><strong class="text-ink">Origem:</strong> {product.origin}</p>
          </details>
          <details class="group py-5">
            <summary class="flex justify-between cursor-pointer list-none eyebrow !text-ink">Envio, trocas & pagamento <span class="group-open:rotate-45 transition">+</span></summary>
            <p class="mt-4 text-sm text-mocha leading-relaxed">Frete grátis acima de {formatBRL(settings.freeShippingThreshold)}. Troca grátis em 30 dias. Pague com Pix ({settings.pixDiscountPercent}% off) ou cartão via Stripe em até 6x sem juros.</p>
          </details>
        </div>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="py-16 lg:py-24 bg-cream">
      <div class="container-site">
        <h2 class="display-md mb-10">Combina com <em class="text-brand">você.</em></h2>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-10 md:gap-x-6">
          {related.map((p, i) => <ProductCard product={p} index={i} />)}
        </div>
      </div>
    </section>
  )}

  <!-- Sticky mobile -->
  <div class="lg:hidden fixed inset-x-0 bottom-0 z-30 glass px-4 py-3 flex items-center gap-3 translate-y-full transition-transform duration-500" data-sticky-buy>
    <div class="flex-1 min-w-0"><p class="font-display text-lg text-ink truncate">{product.name}</p><p class="text-xs text-mocha">{formatBRL(product.price)}</p></div>
    <button class="btn-primary !py-3" data-scroll-buy>Comprar</button>
  </div>

  <!-- Guia de tamanhos -->
  <dialog id="size-guide" class="m-auto rounded-[28px] p-0 backdrop:bg-night/60 w-[min(520px,calc(100%-2rem))] bg-bone">
    <form method="dialog" class="p-8">
      <div class="flex justify-between items-start mb-6"><h3 class="display-md">Descubra o seu número</h3><button class="text-2xl text-mocha" aria-label="Fechar">×</button></div>
      <p class="text-sm text-mocha mb-6">Meça o pé do calcanhar à ponta do dedo maior, em centímetros.</p>
      <label class="field mb-4"><span>Comprimento do pé (cm)</span><input type="range" min="21" max="27" step="0.1" value="23.5" data-foot /></label>
      <p class="text-center"><span class="font-display text-6xl text-brand" data-foot-size>36</span><span class="block text-xs text-mocha mt-1" data-foot-cm>23,5 cm</span></p>
      <table class="w-full mt-6 text-sm text-center"><thead class="text-[10px] uppercase tracking-[0.18em] text-mocha"><tr><th class="py-2">BR</th><th>EU</th><th>cm</th></tr></thead>
        <tbody class="divide-y divide-taupe/20">{[[33, 34, 21.6], [34, 35, 22.3], [35, 36, 23], [36, 37, 23.6], [37, 38, 24.3], [38, 39, 25], [39, 40, 25.6], [40, 41, 26.3]].map(([br, eu, cm]) => <tr><td class="py-2">{br}</td><td>{eu}</td><td>{cm}</td></tr>)}</tbody>
      </table>
    </form>
  </dialog>
</BaseLayout>

<script>
  import { addToCart, type CartItem } from '../../stores/cart';
  import { toast } from '../../scripts/ui';

  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('buy-form') as HTMLFormElement | null;
    if (!form?.dataset.product) return;
    const base = JSON.parse(form.dataset.product) as Omit<CartItem, 'id' | 'quantity' | 'size' | 'color'>;
    const stockMsg = form.querySelector('[data-stock-msg]');

    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'color') { const l = form.querySelector('[data-color-label]'); if (l) l.textContent = t.value; }
      if (t.name === 'size' && stockMsg) { const n = Number(t.dataset.stock); stockMsg.textContent = n <= 2 ? `Restam só ${n} no ${t.value} — garanta já.` : ''; }
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const size = fd.get('size');
      if (typeof size !== 'string') {
        toast('Escolha o seu tamanho ✦');
        form.querySelector('fieldset:nth-of-type(2)')?.animate([{ transform: 'translateX(0)' }, { transform: 'translateX(-6px)' }, { transform: 'translateX(6px)' }, { transform: 'translateX(0)' }], { duration: 320 });
        return;
      }
      const color = (fd.get('color') as string | null) ?? 'Único';
      addToCart({ ...base, size, color, quantity: 1 });
    });

    // Zoom com lupa
    document.querySelectorAll<HTMLElement>('[data-zoom]').forEach((el) => {
      const img = el.querySelector('img');
      if (!img) return;
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        img.style.transformOrigin = `${((e.clientX - r.left) / r.width) * 100}% ${((e.clientY - r.top) / r.height) * 100}%`;
        img.style.transform = 'scale(1.9)';
      });
      el.addEventListener('pointerleave', () => { img.style.transform = ''; });
    });

    // Guia de tamanhos
    const dlg = document.getElementById('size-guide') as HTMLDialogElement | null;
    document.querySelector('[data-open-size-guide]')?.addEventListener('click', () => dlg?.showModal());
    const foot = dlg?.querySelector<HTMLInputElement>('[data-foot]');
    const table: [number, number][] = [[33, 21.6], [34, 22.3], [35, 23], [36, 23.6], [37, 24.3], [38, 25], [39, 25.6], [40, 26.3]];
    foot?.addEventListener('input', () => {
      const cm = Number(foot.value);
      const best = table.find(([, c]) => c >= cm) ?? table[table.length - 1];
      dlg!.querySelector('[data-foot-size]')!.textContent = String(best[0]);
      dlg!.querySelector('[data-foot-cm]')!.textContent = `${cm.toFixed(1).replace('.', ',')} cm`;
    });

    // Barra fixa mobile
    const sticky = document.querySelector<HTMLElement>('[data-sticky-buy]');
    const addBtn = form.querySelector('[data-add-btn]');
    if (sticky && addBtn) {
      new IntersectionObserver(([en]) => sticky.classList.toggle('translate-y-full', en.isIntersecting || en.boundingClientRect.top > 0)).observe(addBtn);
      sticky.querySelector('[data-scroll-buy]')?.addEventListener('click', () => form.scrollIntoView({ behavior: 'smooth', block: 'center' }));
    }
  });
</script>
