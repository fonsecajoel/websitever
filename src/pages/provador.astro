---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProducts } from '../lib/server/catalog';
const products = await getProducts();
const steps = [
  { key: 'occasion', q: 'Para que ocasião?', options: [['trabalho', 'Trabalho', 'Reuniões e poder'], ['festa', 'Festa & noite', 'Brilhar sem esforço'], ['diadia', 'Dia a dia', 'Conforto com estilo'], ['verao', 'Férias & verão', 'Leveza e sol']] },
  { key: 'heel', q: 'Que altura de salto?', options: [['baixo', 'Rasteiro', 'Até 3 cm'], ['medio', 'Médio', '4 a 7 cm'], ['alto', 'Alto', '8 cm ou mais'], ['qualquer', 'Surpreenda-me', 'Sem preferência']] },
  { key: 'style', q: 'O seu estilo em uma palavra?', options: [['classico', 'Clássico', 'Atemporal, nude e preto'], ['ousado', 'Ousado', 'Detalhes e atitude'], ['minimal', 'Minimal', 'Linhas limpas'], ['romantico', 'Romântico', 'Delicado e feminino']] },
] as const;
---

<BaseLayout title="Provador de estilo" description="Responda a 3 perguntas e descubra o par Santo Salto perfeito para si.">
  <section class="relative min-h-[85vh] overflow-hidden bg-blush grain">
    <div class="absolute -top-40 -right-40 w-[600px] h-[600px] rounded-full bg-gold/25 blur-[120px]"></div>
    <div class="relative container-site max-w-4xl py-16 md:py-24" data-quiz>
      <p class="eyebrow mb-4">Provador de estilo · <span data-q-index>1</span>/3</p>
      <div class="h-1 rounded-full bg-sand mb-12 overflow-hidden"><span class="block h-full bg-brand transition-[width] duration-700" style="width:33%" data-q-bar></span></div>
      {steps.map((s, i) => (
        <div class:list={['quiz-step', i > 0 && 'hidden']} data-q-step={i}>
          <h1 class="display-lg mb-10">{s.q}</h1>
          <div class="grid sm:grid-cols-2 gap-4">
            {s.options.map(([v, label, sub]) => (
              <button type="button" class="quiz-opt text-left rounded-[24px] bg-bone/80 border border-taupe/30 p-6 hover:border-brand hover:-translate-y-1 hover:shadow-lift transition-all duration-500" data-key={s.key} data-value={v}>
                <span class="font-display text-3xl text-ink block">{label}</span>
                <span class="text-sm text-mocha">{sub}</span>
              </button>
            ))}
          </div>
        </div>
      ))}
      <div class="hidden" data-q-loading><p class="script text-gold-gradient text-6xl text-center py-20 animate-pulse">A escolher por si…</p></div>
    </div>
  </section>
  <section class="container-site py-16 hidden" data-q-result>
    <p class="eyebrow mb-3">Escolhidos para si</p>
    <h2 class="display-lg mb-10">O seu par perfeito <em class="text-brand">está aqui.</em></h2>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-12 md:gap-x-6">
      {products.map((p, i) => (
        <div class="hidden" data-q-product data-category={p.category} data-collection={p.collection ?? ''} data-heel={p.heelHeight ? parseFloat(p.heelHeight) : 0} data-colors={p.colors.map((c) => c.name.toLowerCase()).join(',')} data-badges={p.badges.join(',')}>
          <ProductCard product={p} index={i} />
        </div>
      ))}
    </div>
    <div class="text-center mt-12"><button type="button" class="btn-ghost text-ink" data-q-restart>Refazer o provador</button></div>
  </section>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const quiz = document.querySelector<HTMLElement>('[data-quiz]');
    if (!quiz) return;
    const answers: Record<string, string> = {};
    const stepsEl = Array.from(quiz.querySelectorAll<HTMLElement>('[data-q-step]'));
    let i = 0;
    const go = (n: number): void => {
      i = n;
      stepsEl.forEach((s, k) => s.classList.toggle('hidden', k !== n));
      quiz.querySelector('[data-q-index]')!.textContent = String(n + 1);
      quiz.querySelector<HTMLElement>('[data-q-bar]')!.style.width = `${((n + 1) / 3) * 100}%`;
    };
    const score = (el: HTMLElement): number => {
      const cat = el.dataset.category ?? '', col = el.dataset.collection ?? '', heel = Number(el.dataset.heel), colors = el.dataset.colors ?? '', badges = el.dataset.badges ?? '';
      let s = 0;
      const occ: Record<string, string[]> = { trabalho: ['scarpin', 'mule', 'bolsa'], festa: ['sandalia', 'scarpin'], diadia: ['tenis', 'rasteira', 'tamanco', 'mule'], verao: ['sandalia', 'rasteira', 'tamanco'] };
      if (occ[answers.occasion]?.includes(cat)) s += 3;
      if (answers.occasion === 'festa' && col === 'noir') s += 2;
      if (answers.occasion === 'verao' && col === 'verao') s += 2;
      if (answers.heel === 'baixo' && heel <= 3) s += 3;
      if (answers.heel === 'medio' && heel >= 4 && heel <= 7) s += 3;
      if (answers.heel === 'alto' && heel >= 8) s += 3;
      if (answers.style === 'classico' && (/bone|cocoa|negro|nude/.test(colors) || col === 'essentials')) s += 2;
      if (answers.style === 'ousado' && (col === 'noir' || badges.includes('edicao'))) s += 2;
      if (answers.style === 'minimal' && col === 'essentials') s += 2;
      if (answers.style === 'romantico' && (col === 'aurora' || col === 'heritage')) s += 2;
      if (badges.includes('best-seller')) s += 0.5;
      return s;
    };
    quiz.addEventListener('click', (e) => {
      const opt = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-key]');
      if (!opt) return;
      answers[opt.dataset.key!] = opt.dataset.value!;
      if (i < 2) { go(i + 1); return; }
      stepsEl.forEach((s) => s.classList.add('hidden'));
      quiz.querySelector('[data-q-loading]')!.classList.remove('hidden');
      setTimeout(() => {
        const items = Array.from(document.querySelectorAll<HTMLElement>('[data-q-product]'));
        const ranked = items.map((el) => ({ el, s: score(el) })).sort((a, b) => b.s - a.s);
        items.forEach((el) => el.classList.add('hidden'));
        ranked.slice(0, 4).forEach(({ el }) => { el.classList.remove('hidden'); el.parentElement?.appendChild(el); });
        quiz.querySelector('[data-q-loading]')!.classList.add('hidden');
        const res = document.querySelector<HTMLElement>('[data-q-result]')!;
        res.classList.remove('hidden');
        res.scrollIntoView({ behavior: 'smooth' });
      }, 900);
    });
    document.querySelector('[data-q-restart]')?.addEventListener('click', () => {
      document.querySelector('[data-q-result]')!.classList.add('hidden');
      go(0);
      quiz.scrollIntoView({ behavior: 'smooth' });
    });
  });
</script>
