---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogGrid from '../../components/CatalogGrid.astro';
import { getCollections, getProducts } from '../../lib/server/catalog';

const { colecao = '' } = Astro.params;
const [collections, products] = await Promise.all([getCollections(), getProducts()]);
const col = collections.find((c) => c.slug === colecao);
if (!col) return Astro.rewrite('/404');
const list = products.filter((p) => p.collection === col.slug);
---

<BaseLayout title={`Coleção ${col.name}`} description={col.description} image={col.coverUrl}>
  <section class="relative h-[70vh] min-h-[480px] mx-2 md:mx-4 mt-2 rounded-[32px] overflow-hidden">
    <img src={col.coverUrl} alt="" class="absolute inset-0 w-full h-full object-cover" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-t from-night/85 via-night/30 to-night/10"></div>
    <div class="relative h-full container-site flex flex-col justify-end pb-14">
      <p class="eyebrow !text-gold mb-4">Coleção</p>
      <h1 class="display-xl !text-bone"><span class="split-line"><span>{col.name}</span></span></h1>
      <p class="script text-gold-soft text-4xl md:text-5xl mt-2">{col.tagline}</p>
      <p class="text-bone/75 max-w-lg mt-5">{col.description}</p>
    </div>
  </section>
  <section class="container-site py-10">
    {list.length > 0 ? <CatalogGrid products={list} /> : <p class="text-center text-mocha py-20">Novas peças em breve.</p>}
  </section>
</BaseLayout>
