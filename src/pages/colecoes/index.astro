---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollections, getProducts } from '../../lib/server/catalog';
const [collections, products] = await Promise.all([getCollections(), getProducts()]);
---

<BaseLayout title="Coleções" description="As coleções Santo Salto: cinco mundos, uma assinatura.">
  <section class="container-site pt-14 md:pt-20 pb-12">
    <p class="eyebrow mb-4">Edições</p>
    <h1 class="display-xl max-w-4xl">Mundos com <em class="text-brand">assinatura.</em></h1>
  </section>
  <section class="container-site space-y-6 md:space-y-10 pb-10">
    {collections.map((c, i) => {
      const count = products.filter((p) => p.collection === c.slug).length;
      return (
        <a href={`/colecoes/${c.slug}`} class="reveal group grid md:grid-cols-12 gap-6 items-center rounded-[32px] overflow-hidden bg-cream hover:bg-blush transition-colors duration-700" data-cursor="Abrir">
          <div class:list={['md:col-span-7 relative aspect-[16/10] overflow-hidden', i % 2 ? 'md:order-2' : '']}>
            <img src={c.coverUrl} alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1600ms] group-hover:scale-105" style="transition-timing-function:var(--ease-silk)" />
          </div>
          <div class="md:col-span-5 p-6 md:p-12">
            <p class="font-display text-taupe text-2xl mb-2">0{i + 1}</p>
            <h2 class="display-lg mb-2">{c.name}</h2>
            <p class="script text-gold-gradient text-4xl mb-5">{c.tagline}</p>
            <p class="text-mocha mb-8 text-pretty">{c.description}</p>
            <span class="eyebrow link-underline">{count} peças · Explorar →</span>
          </div>
        </a>
      );
    })}
  </section>
</BaseLayout>
