---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabaseForRequest } from '../../lib/server/supabase';
import { fmtDate, str } from '../../lib/server/admin/helpers';

const sb = supabaseForRequest(Astro.request, Astro.cookies);

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const id = str(fd, 'id');
  const action = str(fd, '_action');
  let errText = '';
  if (action === 'read') errText = (await sb.from('contact_messages').update({ read: str(fd, 'read') === 'true' }).eq('id', id)).error?.message ?? '';
  if (action === 'delete') errText = (await sb.from('contact_messages').delete().eq('id', id)).error?.message ?? '';
  if (action === 'read_all') errText = (await sb.from('contact_messages').update({ read: true }).eq('read', false)).error?.message ?? '';
  return Astro.redirect(`/admin/mensagens${errText ? `?err=${encodeURIComponent(errText)}` : ''}`);
}

interface Msg { id: string; name: string; email: string; phone: string; subject: string; message: string; read: boolean; created_at: string }
const { data, error } = await sb.from('contact_messages').select('*').order('created_at', { ascending: false }).limit(200);
const msgs = (data ?? []) as Msg[];
const unread = msgs.filter((m) => !m.read).length;
---
<AdminLayout title="Mensagens" active="mensagens" subtitle={`${unread} por ler`}>
  {unread > 0 && (
    <form slot="actions" method="POST"><input type="hidden" name="_action" value="read_all" /><button class="a-btn a-btn-ghost">Marcar todas como lidas</button></form>
  )}
  {error && <div class="a-flash a-flash-err">{error.message}</div>}
  {msgs.length === 0 && <div class="a-card p-12 text-center text-taupe">Caixa vazia. Quando alguém escrever pelo formulário de contacto aparece aqui.</div>}
  <div class="space-y-3">
    {msgs.map((m) => (
      <details class={`a-card group ${m.read ? '' : 'ring-1 ring-brand-red/30'}`} open={!m.read}>
        <summary class="flex items-center gap-4 p-5 cursor-pointer list-none">
          <span class={`w-2.5 h-2.5 rounded-full shrink-0 ${m.read ? 'bg-sand' : 'bg-brand-red'}`}></span>
          <div class="min-w-0 flex-1">
            <p class={`truncate ${m.read ? '' : 'font-semibold'}`}>{m.name} <span class="text-taupe font-normal">· {m.email}</span></p>
            <p class="text-[12.5px] text-mocha truncate">{m.subject || m.message.slice(0, 90)}</p>
          </div>
          <span class="text-[11.5px] text-taupe whitespace-nowrap">{fmtDate(m.created_at)}</span>
        </summary>
        <div class="px-5 pb-5 pl-11 space-y-4">
          <p class="whitespace-pre-line leading-relaxed text-[14px]">{m.message}</p>
          <div class="flex flex-wrap gap-2">
            <a href={`mailto:${m.email}?subject=${encodeURIComponent(`Re: ${m.subject || 'Santo Salto'}`)}`} class="a-btn a-btn-primary a-btn-sm">Responder por e-mail</a>
            {m.phone && <a href={`https://wa.me/${m.phone.replace(/\D/g, '').replace(/^(?!55)(\d{10,11})$/, '55$1')}`} target="_blank" rel="noopener" class="a-btn a-btn-sm text-white" style="background:#25D366">WhatsApp</a>}
            <form method="POST"><input type="hidden" name="_action" value="read" /><input type="hidden" name="id" value={m.id} /><input type="hidden" name="read" value={m.read ? 'false' : 'true'} /><button class="a-btn a-btn-ghost a-btn-sm">{m.read ? 'Marcar como não lida' : 'Marcar como lida'}</button></form>
            <form method="POST" data-confirm="Eliminar esta mensagem?"><input type="hidden" name="_action" value="delete" /><input type="hidden" name="id" value={m.id} /><button class="a-btn a-btn-danger a-btn-sm">Eliminar</button></form>
          </div>
        </div>
      </details>
    ))}
  </div>
</AdminLayout>
