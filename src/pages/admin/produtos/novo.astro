---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createProduct, uploadImage } from '../../../lib/db';
import type { Product } from '../../../data/products';

let success = false;
let error = '';

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    
    const images: { src: string; alt: string }[] = [];
    const imageFiles = form.getAll('images') as File[];
    for (const file of imageFiles) {
      if (file.size > 0) {
        const url = await uploadImage(file);
        images.push({ src: url, alt: form.get('name') as string });
      }
    }

    const imageUrls = (form.get('image_urls') as string || '').split('\n').filter(u => u.trim());
    for (const url of imageUrls) {
      images.push({ src: url.trim(), alt: form.get('name') as string });
    }

    const sizesRaw = (form.get('sizes') as string || '34,35,36,37,38,39,40').split(',');
    const sizes = sizesRaw.map(s => ({ label: s.trim(), available: true }));

    const colorsRaw = (form.get('colors') as string || '').split('\n').filter(c => c.trim());
    const colors = colorsRaw.map(c => {
      const [name, hex] = c.split(':').map(s => s.trim());
      return { name: name || '', hex: hex || '#000000' };
    });

    const product: Product = {
      id: `p${Date.now()}`,
      slug: (form.get('slug') as string) || (form.get('name') as string).toLowerCase().replace(/[^a-z0-9]+/g, '-'),
      name: form.get('name') as string,
      category: form.get('category') as any,
      collection: form.get('collection') as any,
      price: Number(form.get('price')),
      oldPrice: form.get('oldPrice') ? Number(form.get('oldPrice')) : undefined,
      currency: 'BRL',
      shortDescription: form.get('shortDescription') as string || '',
      description: form.get('description') as string || '',
      details: (form.get('details') as string || '').split('\n').filter(d => d.trim()),
      materials: form.get('materials') as string || '',
      origin: form.get('origin') as string || 'Franca, São Paulo · Brasil',
      heelHeight: form.get('heelHeight') as string || undefined,
      colors,
      sizes,
      images,
      badges: (form.getAll('badges') as string[]).filter(b => b) as any[],
      isNew: form.get('isNew') === 'on',
    };

    await createProduct(product);
    return Astro.redirect('/admin/produtos');
  } catch (e: any) {
    error = e.message || 'Erro ao criar produto';
  }
}
---

<AdminLayout title="Novo Produto">
  <div class="admin-header">
    <h2>Novo Produto</h2>
    <a href="/admin/produtos" class="btn btn-secondary">← Voltar</a>
  </div>

  {error && <div style="background: #fef2f2; color: #dc2626; padding: 0.75rem; border-radius: 6px; margin-bottom: 1rem;">{error}</div>}

  <form method="POST" enctype="multipart/form-data" class="card">
    <div class="form-grid">
      <div class="form-group">
        <label for="name">Nome *</label>
        <input type="text" id="name" name="name" required placeholder="Scarpin Aurora" />
      </div>
      <div class="form-group">
        <label for="slug">Slug (auto se vazio)</label>
        <input type="text" id="slug" name="slug" placeholder="scarpin-aurora-mocha" />
      </div>
    </div>

    <div class="form-grid">
      <div class="form-group">
        <label for="category">Categoria *</label>
        <select id="category" name="category" required>
          <option value="scarpin">Scarpin</option>
          <option value="sandalia">Sandália</option>
          <option value="tamanco">Tamanco</option>
          <option value="tenis">Tênis</option>
          <option value="mule">Mule</option>
          <option value="bota">Bota</option>
          <option value="rasteira">Rasteira</option>
          <option value="bolsa">Bolsa</option>
        </select>
      </div>
      <div class="form-group">
        <label for="collection">Coleção *</label>
        <select id="collection" name="collection" required>
          <option value="aurora">Aurora</option>
          <option value="heritage">Heritage</option>
          <option value="noir">Noir</option>
          <option value="verao">Verão</option>
          <option value="essentials">Essentials</option>
        </select>
      </div>
    </div>

    <div class="form-grid">
      <div class="form-group">
        <label for="price">Preço (R$) *</label>
        <input type="number" id="price" name="price" required min="0" step="1" placeholder="689" />
      </div>
      <div class="form-group">
        <label for="oldPrice">Preço Antigo (R$)</label>
        <input type="number" id="oldPrice" name="oldPrice" min="0" step="1" placeholder="829" />
      </div>
    </div>

    <div class="form-group">
      <label for="shortDescription">Descrição Curta</label>
      <input type="text" id="shortDescription" name="shortDescription" placeholder="Scarpin clássico em couro mocha com salto fino de 9cm." />
    </div>

    <div class="form-group">
      <label for="description">Descrição Completa</label>
      <textarea id="description" name="description" placeholder="Descrição detalhada do produto..."></textarea>
    </div>

    <div class="form-group">
      <label for="details">Detalhes (um por linha)</label>
      <textarea id="details" name="details" placeholder="Cabedal em couro legítimo&#10;Forro em couro natural&#10;Salto stiletto de 9cm"></textarea>
    </div>

    <div class="form-grid">
      <div class="form-group">
        <label for="materials">Materiais</label>
        <input type="text" id="materials" name="materials" placeholder="Couro legítimo · Forro em couro" />
      </div>
      <div class="form-group">
        <label for="origin">Origem</label>
        <input type="text" id="origin" name="origin" value="Franca, São Paulo · Brasil" />
      </div>
    </div>

    <div class="form-grid">
      <div class="form-group">
        <label for="heelHeight">Altura do Salto</label>
        <input type="text" id="heelHeight" name="heelHeight" placeholder="9 cm" />
      </div>
      <div class="form-group">
        <label for="sizes">Tamanhos (separados por vírgula)</label>
        <input type="text" id="sizes" name="sizes" value="34,35,36,37,38,39,40" />
      </div>
    </div>

    <div class="form-group">
      <label for="colors">Cores (uma por linha, formato: Nome:#HEX)</label>
      <textarea id="colors" name="colors" placeholder="Mocha:#6B4E3A&#10;Cocoa:#2E1F15&#10;Bone:#F5EFE6"></textarea>
    </div>

    <div class="form-group">
      <label for="images">Upload de Imagens</label>
      <input type="file" id="images" name="images" multiple accept="image/*" />
    </div>

    <div class="form-group">
      <label for="image_urls">Ou URLs de imagens (uma por linha)</label>
      <textarea id="image_urls" name="image_urls" placeholder="https://..."></textarea>
    </div>

    <div class="form-group">
      <label>Badges</label>
      <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <label style="font-weight: normal;"><input type="checkbox" name="badges" value="novo" /> Novo</label>
        <label style="font-weight: normal;"><input type="checkbox" name="badges" value="best-seller" /> Best-seller</label>
        <label style="font-weight: normal;"><input type="checkbox" name="badges" value="edicao-limitada" /> Edição Limitada</label>
        <label style="font-weight: normal;"><input type="checkbox" name="badges" value="ultimas-pecas" /> Últimas Peças</label>
      </div>
    </div>

    <div class="form-group">
      <label style="font-weight: normal;"><input type="checkbox" name="isNew" /> Marcar como Novidade</label>
    </div>

    <button type="submit" class="btn btn-primary">Criar Produto</button>
  </form>
</AdminLayout>
