---
import '../styles/globals.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import SearchPalette from '../components/SearchPalette.astro';
import { getSettings } from '../lib/server/catalog';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noFooter?: boolean;
  noIndex?: boolean;
  transparentHeader?: boolean;
}

const {
  title = 'Santo Salto Store — Elevando mulheres com elegância e poder',
  description = 'Santo Salto Store — calçado feminino com marca própria. Saltos, sandálias, tamancos, tênis, bolsas e acessórios.',
  image = '/img-1754-v2.png',
  noFooter = false,
  noIndex = false,
  transparentHeader = false,
} = Astro.props;

const settings = await getSettings();
const fullTitle = title.includes('Santo Salto') ? title : `${title} | Santo Salto Store`;
const ogImage = new URL(image, Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FFF8F8" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? Astro.url)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500;600&family=Pinyon+Script&display=swap" rel="stylesheet" />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <title>{fullTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ShoeStore',
      name: 'Santo Salto Store',
      url: Astro.site,
      logo: `${Astro.site}logo-sem-fundo.png`,
      email: settings.email,
      telephone: `+${settings.whatsapp}`,
      sameAs: [settings.instagram],
    })} />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header announcement={settings.announcement} transparent={transparentHeader} />
    <main class="flex-1" id="conteudo">
      <slot />
    </main>
    {!noFooter && <Footer settings={settings} />}
    <CartDrawer freeShippingThreshold={settings.freeShippingThreshold} />
    <SearchPalette />

    <a
      href={`https://wa.me/${settings.whatsapp}?text=${encodeURIComponent('Olá Santo Salto! Gostaria de ajuda com ')}`}
      target="_blank" rel="noopener noreferrer"
      class="fixed z-40 bottom-5 right-5 md:bottom-8 md:right-8 group flex items-center gap-3"
      aria-label="Falar com uma consultora no WhatsApp"
      transition:persist="wa"
    >
      <span class="hidden md:block glass rounded-full px-4 py-2 text-[11px] uppercase tracking-[0.2em] text-ink opacity-0 translate-x-3 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-500">Consultora online</span>
      <span class="relative grid place-items-center w-14 h-14 rounded-full bg-brand text-bone shadow-lift">
        <span class="absolute inset-0 rounded-full bg-brand animate-ping opacity-20"></span>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm0 18.2a8.2 8.2 0 01-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1112 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 01-3.3-2.9c-.3-.4.2-.4.7-1.4a.5.5 0 000-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 00-.7.3 3 3 0 00-.9 2.2 5.2 5.2 0 001.1 2.7 11.8 11.8 0 004.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 001.8-1.2 2.2 2.2 0 00.1-1.3c0-.1-.2-.2-.5-.3z"/></svg>
      </span>
    </a>

    <div class="cursor-dot" aria-hidden="true" transition:persist="cursor-dot"></div>
    <div class="cursor-ring" aria-hidden="true" transition:persist="cursor-ring"><span data-cursor-label></span></div>

    <script>
      import { initReveal, initCursor } from '../scripts/ui';
      initCursor();
      initReveal();
      document.addEventListener('astro:page-load', () => initReveal());
      document.addEventListener('astro:after-swap', () => initReveal());
    </script>
  </body>
</html>
