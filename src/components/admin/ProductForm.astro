---
import type { Category, Collection, Product } from '../../lib/types';
import { BADGE_LABEL } from '../../lib/types';
import { BADGES } from '../../lib/server/admin/helpers';

interface Props {
  product?: Product | null;
  categories: Pick<Category, 'slug' | 'label'>[];
  collections: Pick<Collection, 'slug' | 'name'>[];
  error?: string;
}
const { product, categories, collections, error } = Astro.props;
const isEdit = Boolean(product?.id);
const p = product;
const colors = p?.colors.length ? p.colors : [{ name: '', hex: '#6B0E09' }];
const sizes = p?.sizes.length ? p.sizes : ['34', '35', '36', '37', '38', '39'].map((l) => ({ label: l, stock: 0 }));
const images = p?.images ?? [];
---
<form method="POST" id="product-form" class="grid xl:grid-cols-3 gap-6">
  <input type="hidden" name="_action" value="save" />
  <div class="xl:col-span-2 space-y-6">
    {error && <div class="a-flash a-flash-err">{error}</div>}

    <section class="a-card p-6 space-y-4">
      <p class="a-eyebrow">Informação</p>
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="a-label" for="name">Nome *</label>
          <input class="a-input" id="name" name="name" required value={p?.name ?? ''} />
        </div>
        <div>
          <label class="a-label" for="slug">Slug (URL)</label>
          <input class="a-input" id="slug" name="slug" value={p?.slug ?? ''} placeholder="gerado a partir do nome" data-touched={isEdit ? '1' : ''} />
        </div>
      </div>
      <div>
        <label class="a-label" for="short_description">Descrição curta</label>
        <input class="a-input" id="short_description" name="short_description" maxlength="180" value={p?.shortDescription ?? ''} />
      </div>
      <div>
        <label class="a-label" for="description">Descrição completa</label>
        <textarea class="a-textarea" id="description" name="description" rows="5">{p?.description ?? ''}</textarea>
      </div>
      <div>
        <label class="a-label" for="details">Detalhes (um por linha)</label>
        <textarea class="a-textarea" id="details" name="details" rows="4">{p?.details.join('\n') ?? ''}</textarea>
      </div>
      <div class="grid sm:grid-cols-3 gap-4">
        <div><label class="a-label" for="materials">Materiais</label><input class="a-input" id="materials" name="materials" value={p?.materials ?? ''} /></div>
        <div><label class="a-label" for="origin">Origem</label><input class="a-input" id="origin" name="origin" value={p?.origin ?? ''} /></div>
        <div><label class="a-label" for="heel_height">Altura do salto</label><input class="a-input" id="heel_height" name="heel_height" value={p?.heelHeight ?? ''} placeholder="ex.: 9 cm" /></div>
      </div>
    </section>

    <section class="a-card p-6 space-y-4">
      <div class="flex items-center justify-between">
        <p class="a-eyebrow">Imagens</p>
        <label class="a-btn a-btn-ghost a-btn-sm cursor-pointer">
          <input type="file" id="img-upload" accept="image/*" multiple class="sr-only" />
          ↑ Carregar imagens
        </label>
      </div>
      <p id="img-status" class="text-[12px] text-taupe hidden"></p>
      <div id="img-list" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
        {images.map((im) => (
          <div class="img-item group relative rounded-2xl overflow-hidden bg-cream border border-cocoa/10">
            <img src={im.src} alt="" class="w-full aspect-[4/5] object-cover" loading="lazy" />
            <input type="hidden" name="image_src" value={im.src} />
            <input name="image_alt" value={im.alt} class="w-full text-[11px] px-2 py-1.5 border-t border-cocoa/10 bg-white" placeholder="Texto alternativo" />
            <div class="absolute top-2 right-2 flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
              <button type="button" data-move="-1" class="w-7 h-7 rounded-full bg-white/90 text-ink text-xs shadow" aria-label="Mover para trás">←</button>
              <button type="button" data-move="1" class="w-7 h-7 rounded-full bg-white/90 text-ink text-xs shadow" aria-label="Mover para a frente">→</button>
              <button type="button" data-remove class="w-7 h-7 rounded-full bg-brand-red text-white text-xs shadow" aria-label="Remover">✕</button>
            </div>
          </div>
        ))}
      </div>
      <div class="flex gap-2">
        <input id="img-url" class="a-input" placeholder="…ou cole um URL de imagem" />
        <button type="button" id="img-url-add" class="a-btn a-btn-ghost">Adicionar</button>
      </div>
      <p class="text-[11.5px] text-taupe">A primeira imagem é a capa. Arraste com as setas para reordenar.</p>
    </section>

    <section class="grid lg:grid-cols-2 gap-6">
      <div class="a-card p-6 space-y-3">
        <div class="flex items-center justify-between">
          <p class="a-eyebrow">Tamanhos & stock</p>
          <button type="button" class="a-btn a-btn-ghost a-btn-sm" data-add="size">+ Tamanho</button>
        </div>
        <div id="size-list" class="space-y-2">
          {sizes.map((s) => (
            <div class="rep-row flex gap-2 items-center">
              <input class="a-input !w-24" name="size_label" value={s.label} placeholder="37" />
              <input class="a-input" type="number" min="0" name="size_stock" value={s.stock} placeholder="Stock" />
              <button type="button" data-remove-row class="text-brand-red px-2" aria-label="Remover">✕</button>
            </div>
          ))}
        </div>
      </div>

      <div class="a-card p-6 space-y-3">
        <div class="flex items-center justify-between">
          <p class="a-eyebrow">Cores</p>
          <button type="button" class="a-btn a-btn-ghost a-btn-sm" data-add="color">+ Cor</button>
        </div>
        <div id="color-list" class="space-y-2">
          {colors.map((c) => (
            <div class="rep-row flex gap-2 items-center">
              <input type="color" name="color_hex" value={c.hex} class="w-11 h-10 rounded-lg border border-cocoa/15 cursor-pointer bg-white p-1" />
              <input class="a-input" name="color_name" value={c.name} placeholder="ex.: Mocha" />
              <button type="button" data-remove-row class="text-brand-red px-2" aria-label="Remover">✕</button>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>

  <aside class="space-y-6">
    <section class="a-card p-6 space-y-4 xl:sticky xl:top-24">
      <p class="a-eyebrow">Publicação</p>
      <label class="flex items-center justify-between gap-3 cursor-pointer">
        <span class="font-medium">Visível na loja</span>
        <input type="checkbox" name="active" class="sr-only" checked={p ? p.active : true} /><span class="a-switch"></span>
      </label>
      <label class="flex items-center justify-between gap-3 cursor-pointer">
        <span class="font-medium">Marcar como novidade</span>
        <input type="checkbox" name="is_new" class="sr-only" checked={p?.isNew ?? false} /><span class="a-switch"></span>
      </label>

      <div class="grid grid-cols-2 gap-3">
        <div><label class="a-label" for="price">Preço (R$) *</label><input class="a-input" id="price" name="price" type="number" step="0.01" min="0" required value={p?.price ?? ''} /></div>
        <div><label class="a-label" for="old_price">Preço antigo</label><input class="a-input" id="old_price" name="old_price" type="number" step="0.01" min="0" value={p?.oldPrice ?? ''} /></div>
      </div>
      <div>
        <label class="a-label" for="category">Categoria *</label>
        <select class="a-select" id="category" name="category" required>
          <option value="">— escolher —</option>
          {categories.map((c) => <option value={c.slug} selected={c.slug === p?.category}>{c.label}</option>)}
        </select>
      </div>
      <div>
        <label class="a-label" for="collection">Coleção</label>
        <select class="a-select" id="collection" name="collection">
          <option value="">Sem coleção</option>
          {collections.map((c) => <option value={c.slug} selected={c.slug === p?.collection}>{c.name}</option>)}
        </select>
      </div>
      <div>
        <p class="a-label">Etiquetas</p>
        <div class="flex flex-wrap gap-2">
          {BADGES.map((b) => (
            <label class="cursor-pointer">
              <input type="checkbox" name="badges" value={b} class="peer sr-only" checked={p?.badges.includes(b) ?? false} />
              <span class="inline-block px-3 py-1.5 rounded-full text-[12px] border border-cocoa/15 peer-checked:bg-cocoa peer-checked:text-bone peer-checked:border-cocoa transition-colors">{BADGE_LABEL[b]}</span>
            </label>
          ))}
        </div>
      </div>
      <div><label class="a-label" for="sort_order">Ordem</label><input class="a-input" id="sort_order" name="sort_order" type="number" value={p?.sortOrder ?? 0} /></div>

      <button class="a-btn a-btn-primary w-full !py-3">{isEdit ? 'Guardar alterações' : 'Criar produto'}</button>
      {isEdit && p && <a href={`/produto/${p.slug}`} target="_blank" rel="noopener" class="a-btn a-btn-ghost w-full">Ver na loja ↗</a>}
    </section>
  </aside>
</form>

<template id="tpl-size">
  <div class="rep-row flex gap-2 items-center">
    <input class="a-input !w-24" name="size_label" placeholder="37" />
    <input class="a-input" type="number" min="0" name="size_stock" value="0" placeholder="Stock" />
    <button type="button" data-remove-row class="text-brand-red px-2" aria-label="Remover">✕</button>
  </div>
</template>
<template id="tpl-color">
  <div class="rep-row flex gap-2 items-center">
    <input type="color" name="color_hex" value="#6B0E09" class="w-11 h-10 rounded-lg border border-cocoa/15 cursor-pointer bg-white p-1" />
    <input class="a-input" name="color_name" placeholder="ex.: Mocha" />
    <button type="button" data-remove-row class="text-brand-red px-2" aria-label="Remover">✕</button>
  </div>
</template>
<template id="tpl-img">
  <div class="img-item group relative rounded-2xl overflow-hidden bg-cream border border-cocoa/10">
    <img src="" alt="" class="w-full aspect-[4/5] object-cover" />
    <input type="hidden" name="image_src" value="" />
    <input name="image_alt" value="" class="w-full text-[11px] px-2 py-1.5 border-t border-cocoa/10 bg-white" placeholder="Texto alternativo" />
    <div class="absolute top-2 right-2 flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
      <button type="button" data-move="-1" class="w-7 h-7 rounded-full bg-white/90 text-ink text-xs shadow" aria-label="Mover para trás">←</button>
      <button type="button" data-move="1" class="w-7 h-7 rounded-full bg-white/90 text-ink text-xs shadow" aria-label="Mover para a frente">→</button>
      <button type="button" data-remove class="w-7 h-7 rounded-full bg-brand-red text-white text-xs shadow" aria-label="Remover">✕</button>
    </div>
  </div>
</template>

<script>
  const $ = <T extends Element>(sel: string): T | null => document.querySelector<T>(sel);

  // slug automático
  const nameEl = $<HTMLInputElement>('#name');
  const slugEl = $<HTMLInputElement>('#slug');
  const slugify = (s: string): string =>
    s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  slugEl?.addEventListener('input', () => { slugEl.dataset.touched = '1'; });
  nameEl?.addEventListener('input', () => {
    if (slugEl && !slugEl.dataset.touched) slugEl.value = slugify(nameEl.value);
  });

  // repetidores
  document.querySelectorAll<HTMLButtonElement>('[data-add]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const kind = btn.dataset.add;
      const tpl = $<HTMLTemplateElement>(`#tpl-${kind}`);
      const list = $<HTMLElement>(`#${kind}-list`);
      if (tpl && list) list.appendChild(tpl.content.cloneNode(true));
    });
  });
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-remove-row]')) t.closest('.rep-row')?.remove();
    const item = t.closest<HTMLElement>('.img-item');
    if (!item) return;
    if (t.closest('[data-remove]')) item.remove();
    const mv = t.closest<HTMLElement>('[data-move]');
    if (mv) {
      const dir = Number(mv.dataset.move);
      const sib = dir < 0 ? item.previousElementSibling : item.nextElementSibling;
      if (sib) dir < 0 ? sib.before(item) : sib.after(item);
    }
  });

  // imagens
  const list = $<HTMLElement>('#img-list');
  const statusEl = $<HTMLElement>('#img-status');
  const addImage = (src: string, alt = ''): void => {
    const tpl = $<HTMLTemplateElement>('#tpl-img');
    if (!tpl || !list) return;
    const frag = tpl.content.cloneNode(true) as DocumentFragment;
    const img = frag.querySelector('img');
    const hidden = frag.querySelector<HTMLInputElement>('input[name="image_src"]');
    const altEl = frag.querySelector<HTMLInputElement>('input[name="image_alt"]');
    if (img) img.src = src;
    if (hidden) hidden.value = src;
    if (altEl) altEl.value = alt || nameEl?.value || '';
    list.appendChild(frag);
  };
  const setStatus = (t: string): void => {
    if (!statusEl) return;
    statusEl.textContent = t;
    statusEl.classList.toggle('hidden', t === '');
  };

  $<HTMLInputElement>('#img-upload')?.addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const files = Array.from(input.files ?? []);
    for (const [i, file] of files.entries()) {
      setStatus(`A carregar ${i + 1}/${files.length}: ${file.name}…`);
      const body = new FormData();
      body.append('file', file);
      body.append('slug', slugEl?.value || 'produto');
      const res = await fetch('/api/admin/upload', { method: 'POST', body });
      const json = (await res.json()) as { url?: string; error?: string };
      if (!res.ok || !json.url) { setStatus(`Erro: ${json.error ?? res.statusText}`); return; }
      addImage(json.url);
    }
    setStatus('');
    input.value = '';
  });
  $<HTMLButtonElement>('#img-url-add')?.addEventListener('click', () => {
    const u = $<HTMLInputElement>('#img-url');
    if (u && /^https?:\/\/|^\//.test(u.value.trim())) { addImage(u.value.trim()); u.value = ''; }
  });
</script>
