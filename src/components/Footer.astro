---
import type { StoreSettings } from '../lib/types';
interface Props { settings: StoreSettings }
const { settings } = Astro.props;
const year = new Date().getFullYear();
const cols = [
  { title: 'Loja', links: [['Novidades', '/colecao/novidades'], ['Saltos', '/colecao/scarpin'], ['Sandálias', '/colecao/sandalia'], ['Bolsas', '/colecao/bolsa'], ['Coleções', '/colecoes'], ['Provador de estilo', '/provador']] },
  { title: 'Ajuda', links: [['Central de ajuda', '/ajuda'], ['Trocas e devoluções', '/trocas'], ['Acompanhar encomenda', '/conta'], ['Contacto', '/contato']] },
  { title: 'A marca', links: [['Sobre nós', '/sobre'], ['Atelier', '/atelier'], ['Sustentabilidade', '/sustentabilidade'], ['Privacidade', '/privacidade'], ['Termos', '/termos'], ['Cookies', '/cookies']] },
];
---

<footer class="relative bg-night text-bone/80 overflow-hidden mt-24">
  <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[900px] h-[900px] rounded-full bg-brand/20 blur-[140px] pointer-events-none"></div>

  <section class="relative container-site pt-20 pb-14 grid lg:grid-cols-12 gap-14 border-b border-gold/15">
    <div class="lg:col-span-5">
      <p class="eyebrow !text-gold mb-5">Clube Santo Salto</p>
      <h2 class="display-md !text-bone mb-4 text-balance">Lançamentos em primeira mão. <em class="text-gold-gradient not-italic script text-[1.2em]">Sempre.</em></h2>
      <p class="text-bone/60 mb-8 max-w-md">Receba novidades, edições limitadas e 10% na primeira compra.</p>
      <form id="newsletter-form" class="flex flex-col sm:flex-row gap-3 max-w-md">
        <label class="sr-only" for="nl-email">E-mail</label>
        <input id="nl-email" name="email" type="email" required placeholder="o.seu@email.com" class="flex-1 rounded-full bg-white/5 border border-gold/25 px-6 py-4 text-bone placeholder:text-bone/40 focus:outline-none focus:border-gold" />
        <button class="btn-gold">Quero entrar</button>
      </form>
      <p id="newsletter-msg" class="text-sm text-gold-soft mt-3 min-h-5" role="status"></p>
    </div>
    <div class="lg:col-span-7 grid grid-cols-2 md:grid-cols-3 gap-10">
      {cols.map((c) => (
        <div>
          <p class="text-[11px] uppercase tracking-[0.3em] text-gold mb-5">{c.title}</p>
          <ul class="space-y-3 text-sm">
            {c.links.map(([label, href]) => <li><a href={href} class="link-underline hover:text-bone transition">{label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <div class="relative container-site py-10 grid md:grid-cols-3 gap-6 items-center text-sm">
    <div class="space-y-1">
      <a href={`mailto:${settings.email}`} class="block hover:text-gold transition">{settings.email}</a>
      <a href={`https://wa.me/${settings.whatsapp}`} target="_blank" rel="noopener noreferrer" class="block hover:text-gold transition">WhatsApp +{settings.whatsapp.replace(/^(\d{2})(\d{2})(\d{5})(\d{4})$/, '$1 $2 $3-$4')}</a>
    </div>
    <div class="flex md:justify-center gap-3">
      <a href={settings.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-11 h-11 rounded-full border border-gold/30 grid place-items-center hover:bg-gold hover:text-night transition">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
      </a>
      <a href={`https://wa.me/${settings.whatsapp}`} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="w-11 h-11 rounded-full border border-gold/30 grid place-items-center hover:bg-gold hover:text-night transition">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2z" opacity=".9"/></svg>
      </a>
    </div>
    <div class="flex md:justify-end gap-2 items-center text-[10px] uppercase tracking-[0.2em] text-bone/50">
      <span class="chip border border-gold/25">Pix</span><span class="chip border border-gold/25">Stripe</span><span class="chip border border-gold/25">Visa · Master · Amex</span>
    </div>
  </div>

  <div class="relative select-none pointer-events-none overflow-hidden">
    <p class="script text-gold/15 text-center leading-none whitespace-nowrap" style="font-size: clamp(5rem, 22vw, 22rem); margin-bottom: -0.25em;">Santo Salto</p>
  </div>
  <div class="relative container-site py-6 flex flex-col md:flex-row justify-between gap-2 text-[11px] text-bone/45 border-t border-gold/10">
    <p>© {year} Santo Salto Store · CNPJ 56.159.388/0001-22</p>
    <p>Elevando mulheres com elegância e poder.</p>
  </div>
</footer>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
    const msg = document.getElementById('newsletter-msg');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = new FormData(form).get('email');
      if (msg) msg.textContent = 'A enviar…';
      const res = await fetch('/api/newsletter', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email }) });
      const out = (await res.json()) as { ok?: boolean; error?: string };
      if (msg) msg.textContent = out.ok ? 'Bem-vinda ao Clube! Use o cupão BEMVINDA10 ✦' : out.error ?? 'Não foi possível subscrever.';
      if (out.ok) form.reset();
    });
  });
</script>
