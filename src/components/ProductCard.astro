---
import type { Product } from '../data/products';
import { formatBRL } from '../data/products';

interface Props {
  product: Product;
  priority?: boolean;
}

const { product, priority = false } = Astro.props;
const hasDiscount = product.oldPrice && product.oldPrice > product.price;
const discountPct = hasDiscount ? Math.round((1 - product.price / product.oldPrice!) * 100) : 0;

const badgeStyles: Record<string, string> = {
  'novo': 'bg-cocoa text-bone',
  'best-seller': 'bg-gold text-ink',
  'edicao-limitada': 'bg-mocha text-bone',
  'ultimas-pecas': 'bg-rose text-ink',
};

const badgeLabels: Record<string, string> = {
  'novo': 'Novo',
  'best-seller': 'Best-seller',
  'edicao-limitada': 'Edição limitada',
  'ultimas-pecas': 'Últimas peças',
};
---

<article class="group relative">
  <a href={`/produto/${product.slug}`} class="block">
    <div class="relative overflow-hidden bg-cream aspect-[4/5]">
      <img
        src={product.images[0].src}
        alt={product.images[0].alt}
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover transition-all duration-[1200ms] group-hover:scale-[1.04]"
        style="transition-timing-function: var(--ease-silk);"
      />
      {product.images[1] && (
        <img
          src={product.images[1].src}
          alt={product.images[1].alt}
          loading="lazy"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100 transition-opacity duration-700"
        />
      )}

      {product.badges && product.badges.length > 0 && (
        <div class="absolute top-4 left-4 flex flex-col gap-1.5">
          {product.badges.map((b) => (
            <span class={`text-[10px] uppercase tracking-[0.18em] px-2.5 py-1 ${badgeStyles[b]}`}>
              {badgeLabels[b]}
            </span>
          ))}
        </div>
      )}

      {hasDiscount && (
        <span class="absolute top-4 right-4 text-[10px] uppercase tracking-[0.18em] px-2.5 py-1 bg-bone text-cocoa">
          −{discountPct}%
        </span>
      )}

      <button
        type="button"
        class="absolute bottom-4 left-4 right-4 bg-bone/95 backdrop-blur-sm text-cocoa text-xs uppercase tracking-[0.2em] py-3 opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500 hover:bg-cocoa hover:text-bone"
        style="transition-timing-function: var(--ease-silk);"
        data-quick-view={product.slug}
        onclick="event.preventDefault(); window.location.href=`/produto/${this.dataset.quickView}`"
      >
        Visualizar
      </button>
    </div>

    <div class="pt-4 pb-2">
      <div class="flex items-start justify-between gap-3 mb-1">
        <h3 class="font-display text-lg md:text-xl text-ink leading-tight">{product.name}</h3>
      </div>
      <p class="text-xs text-mocha mb-2 line-clamp-1">{product.shortDescription}</p>

      <div class="flex items-baseline gap-2">
        <span class="text-sm font-medium text-cocoa">{formatBRL(product.price)}</span>
        {hasDiscount && (
          <span class="text-xs text-mocha/70 line-through">{formatBRL(product.oldPrice!)}</span>
        )}
      </div>

      {product.colors.length > 1 && (
        <div class="flex items-center gap-1.5 mt-3">
          {product.colors.slice(0, 4).map((c) => (
            <span
              class="w-3 h-3 rounded-full border border-taupe/40"
              style={`background-color: ${c.hex}`}
              title={c.name}
            ></span>
          ))}
          {product.colors.length > 4 && (
            <span class="text-[10px] text-mocha ml-1">+{product.colors.length - 4}</span>
          )}
        </div>
      )}
    </div>
  </a>
</article>
