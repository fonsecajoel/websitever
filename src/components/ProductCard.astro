---
import type { Product } from '../lib/types';
import { BADGE_LABEL } from '../lib/types';
import { formatBRL } from '../lib/pricing';

interface Props { product: Product; priority?: boolean; index?: number }
const { product, priority = false, index = 0 } = Astro.props;
const hasDiscount = product.oldPrice !== null && product.oldPrice > product.price;
const discountPct = hasDiscount && product.oldPrice ? Math.round((1 - product.price / product.oldPrice) * 100) : 0;
const inStock = product.sizes.some((s) => s.stock > 0);
const lowStock = inStock && product.sizes.reduce((s, x) => s + x.stock, 0) <= 4;
const img0 = product.images[0];
const img1 = product.images[1];
---

<article class="product-card group relative" data-product-card data-slug={product.slug}>
  <div class="tilt relative rounded-[22px] overflow-hidden bg-cream aspect-[4/5]" data-tilt>
    <a href={`/produto/${product.slug}`} class="absolute inset-0 block" data-cursor="Ver" aria-label={product.name}>
      {img0 && (
        <img
          src={img0.src}
          alt={img0.alt}
          loading={priority ? 'eager' : 'lazy'}
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1400ms] group-hover:scale-[1.06]"
          style="transition-timing-function: var(--ease-silk)"
          transition:name={`product-${product.slug}`}
        />
      )}
      {img1 && (
        <img src={img1.src} alt="" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100 transition-opacity duration-700" />
      )}
      <span class="tilt-shine absolute inset-0 pointer-events-none"></span>
    </a>

    <div class="absolute top-3 left-3 flex flex-col gap-1.5 pointer-events-none">
      {product.badges.map((b) => (
        <span class:list={['chip', b === 'best-seller' ? 'bg-gold text-night' : b === 'novo' ? 'bg-ink text-bone' : 'glass text-ink']}>{BADGE_LABEL[b]}</span>
      ))}
      {hasDiscount && <span class="chip bg-brand text-bone">−{discountPct}%</span>}
    </div>

    <button
      type="button"
      class="wish-btn absolute top-3 right-3 w-10 h-10 rounded-full glass grid place-items-center text-ink hover:text-brand transition"
      data-wish={product.slug}
      aria-label={`Adicionar ${product.name} aos favoritos`}
      aria-pressed="false"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20.8 4.6a5.5 5.5 0 00-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 00-7.8 7.8L12 21.2l8.8-8.8a5.5 5.5 0 000-7.8z"/></svg>
    </button>

    {inStock && (
      <div class="quick-add absolute inset-x-3 bottom-3 glass rounded-2xl p-3 translate-y-[120%] group-hover:translate-y-0 group-focus-within:translate-y-0 transition-transform duration-500" style="transition-timing-function: var(--ease-silk)">
        <p class="text-[10px] uppercase tracking-[0.22em] text-mocha mb-2">Adicionar rápido · tamanho</p>
        <div class="flex flex-wrap gap-1.5">
          {product.sizes.map((s) => (
            <button
              type="button"
              disabled={s.stock === 0}
              class="min-w-9 h-9 px-2 rounded-full text-xs border border-taupe/40 bg-bone/70 hover:bg-brand hover:text-bone hover:border-brand transition disabled:opacity-30 disabled:line-through disabled:pointer-events-none"
              data-quick-add
              data-product={JSON.stringify({ productId: product.id, slug: product.slug, name: product.name, price: product.price, image: img0?.src ?? '', color: product.colors[0]?.name ?? 'Único', size: s.label })}
            >{s.label}</button>
          ))}
        </div>
      </div>
    )}
    {!inStock && <span class="absolute inset-x-3 bottom-3 chip glass text-ink justify-center">Esgotado · avise-me</span>}
  </div>

  <a href={`/produto/${product.slug}`} class="block pt-4 px-1">
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-display text-xl md:text-[1.4rem] text-ink leading-tight">{product.name}</h3>
      <div class="text-right shrink-0">
        <p class="text-sm font-medium text-ink">{formatBRL(product.price)}</p>
        {hasDiscount && product.oldPrice && <p class="text-xs text-taupe line-through">{formatBRL(product.oldPrice)}</p>}
      </div>
    </div>
    <div class="mt-1.5 flex items-center justify-between">
      <div class="flex gap-1.5">
        {product.colors.slice(0, 4).map((c) => (
          <span class="w-3.5 h-3.5 rounded-full ring-1 ring-taupe/40" style={`background:${c.hex}`} title={c.name}></span>
        ))}
      </div>
      {lowStock && <span class="text-[10px] uppercase tracking-[0.18em] text-brand">Últimas unidades</span>}
      {!lowStock && product.heelHeight && <span class="text-[10px] uppercase tracking-[0.18em] text-taupe">Salto {product.heelHeight}</span>}
    </div>
  </a>
</article>

<style>
  .tilt { transform-style: preserve-3d; transition: transform .6s var(--ease-silk), box-shadow .6s var(--ease-silk); will-change: transform; }
  .group:hover .tilt { box-shadow: var(--shadow-lift); }
  .tilt-shine { background: radial-gradient(600px circle at var(--mx, 50%) var(--my, 50%), rgba(255, 255, 255, .28), transparent 40%); opacity: 0; transition: opacity .5s; }
  .group:hover .tilt-shine { opacity: 1; }
  .wish-btn[aria-pressed='true'] { color: var(--color-brand); }
  .wish-btn[aria-pressed='true'] svg { fill: currentColor; }
  @media (hover: none) { .quick-add { display: none; } }
</style>

<script>
  import { addToCart, type CartItem } from '../stores/cart';
  import { toggleWishlist, wishlist } from '../stores/wishlist';
  import { toast } from '../scripts/ui';

  let bound = false;
  const syncWish = (): void => {
    const list = wishlist.get();
    document.querySelectorAll<HTMLButtonElement>('[data-wish]').forEach((b) => b.setAttribute('aria-pressed', String(list.includes(b.dataset.wish ?? ''))));
  };

  document.addEventListener('astro:page-load', () => {
    syncWish();
    if (window.matchMedia('(pointer: fine)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
        el.addEventListener('pointermove', (e) => {
          const r = el.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width;
          const py = (e.clientY - r.top) / r.height;
          el.style.transform = `perspective(900px) rotateY(${(px - 0.5) * 7}deg) rotateX(${(0.5 - py) * 7}deg)`;
          el.style.setProperty('--mx', `${px * 100}%`);
          el.style.setProperty('--my', `${py * 100}%`);
        });
        el.addEventListener('pointerleave', () => { el.style.transform = ''; });
      });
    }
    if (bound) return;
    bound = true;
    wishlist.subscribe(syncWish);
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const wish = t.closest<HTMLButtonElement>('[data-wish]');
      if (wish) {
        e.preventDefault();
        const added = toggleWishlist(wish.dataset.wish ?? '');
        toast(added ? 'Guardado nos favoritos ♥' : 'Removido dos favoritos');
        return;
      }
      const quick = t.closest<HTMLButtonElement>('[data-quick-add]');
      if (quick?.dataset.product) {
        e.preventDefault();
        const p = JSON.parse(quick.dataset.product) as Omit<CartItem, 'id' | 'quantity'>;
        addToCart({ ...p, quantity: 1 });
      }
    });
  });
</script>
