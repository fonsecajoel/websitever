---
interface Props { announcement: string; transparent?: boolean }
const { announcement, transparent = false } = Astro.props;

const navItems = [
  { label: 'Novidades', href: '/colecao/novidades' },
  { label: 'Saltos', href: '/colecao/scarpin' },
  { label: 'Sandálias', href: '/colecao/sandalia' },
  { label: 'Tênis', href: '/colecao/tenis' },
  { label: 'Botas', href: '/colecao/bota' },
  { label: 'Bolsas', href: '/colecao/bolsa' },
  { label: 'Coleções', href: '/colecoes' },
  { label: 'Provador', href: '/provador', accent: true },
];
const parts = announcement.split('·').map((s) => s.trim()).filter(Boolean);
const path = Astro.url.pathname;
---

<div class="bg-ink text-gold-pale text-[10.5px] uppercase tracking-[0.3em] py-2.5 overflow-hidden relative z-50" transition:persist="announce">
  <div class="flex animate-marquee whitespace-nowrap w-max">
    {[0, 1].map(() => (
      <div class="flex shrink-0 items-center">
        {[...parts, ...parts].map((p) => (
          <span class="flex items-center gap-10 pr-10">{p}<span class="text-gold">✦</span></span>
        ))}
      </div>
    ))}
  </div>
</div>

<header
  id="site-header"
  data-transparent={transparent ? 'true' : 'false'}
  class="sticky top-0 z-40 transition-all duration-700"
>
  <div class="header-shell mx-2 md:mx-4 mt-2 rounded-full transition-all duration-700">
    <div class="container-site !px-4 md:!px-6">
      <div class="grid grid-cols-[1fr_auto_1fr] items-center h-16 md:h-[72px]">
        <div class="flex items-center gap-1 md:gap-3">
          <button id="menu-toggle" class="lg:hidden icon-btn" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-menu">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 8h16M4 16h10"/></svg>
          </button>
          <nav class="hidden lg:flex items-center gap-6 xl:gap-8" aria-label="Principal">
            {navItems.slice(0, 4).map((i) => (
              <a href={i.href} class:list={['nav-link', { 'is-active': path.startsWith(i.href) }]}>{i.label}</a>
            ))}
          </nav>
        </div>

        <a href="/" class="block" aria-label="Santo Salto — Página inicial">
          <img src="/logo-navbar.png" alt="Santo Salto Store" class="h-10 md:h-12 w-auto object-contain" width="160" height="48" />
        </a>

        <div class="flex items-center justify-end gap-1 md:gap-3">
          <nav class="hidden xl:flex items-center gap-6 mr-3" aria-label="Secundária">
            {navItems.slice(4).map((i) => (
              <a href={i.href} class:list={['nav-link', { 'is-active': path.startsWith(i.href), 'nav-accent': i.accent }]}>{i.label}</a>
            ))}
          </nav>
          <button data-open-search class="icon-btn group flex items-center gap-2" aria-label="Pesquisar (Ctrl+K)">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.5-4.5"/></svg>
          </button>
          <a href="/conta" class="icon-btn hidden md:grid" aria-label="Minha conta">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>
          </a>
          <a href="/lista-desejos" class="icon-btn relative" aria-label="Lista de desejos">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.8 4.6a5.5 5.5 0 00-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 00-7.8 7.8L12 21.2l8.8-8.8a5.5 5.5 0 000-7.8z"/></svg>
            <span data-wish-count class="badge-dot hidden">0</span>
          </a>
          <button id="cart-toggle" class="icon-btn relative" aria-label="Abrir sacola">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 7h14l-1.5 12.5a2 2 0 01-2 1.5h-7a2 2 0 01-2-1.5L5 7z"/><path d="M9 7V5a3 3 0 016 0v2"/></svg>
            <span id="cart-count" class="badge-dot hidden">0</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</header>

<div id="mobile-menu" class="fixed inset-0 z-[60] pointer-events-none" aria-hidden="true">
  <div data-menu-backdrop class="absolute inset-0 bg-night/50 opacity-0 transition-opacity duration-500"></div>
  <div data-menu-panel class="absolute inset-y-0 left-0 w-[88%] max-w-sm bg-bone grain -translate-x-full transition-transform duration-700 flex flex-col" style="transition-timing-function: var(--ease-silk)">
    <div class="flex items-center justify-between px-6 h-20 border-b border-taupe/25">
      <img src="/logo-navbar.png" alt="Santo Salto" class="h-10 w-auto" />
      <button id="menu-close" class="icon-btn" aria-label="Fechar menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <nav class="px-6 py-8 flex-1 overflow-y-auto">
      {navItems.map((item, i) => (
        <a href={item.href} class="menu-item flex items-baseline justify-between py-3 border-b border-taupe/15" style={`--i:${i}`}>
          <span class:list={['font-display text-[2rem] leading-none', item.accent ? 'text-brand italic' : 'text-ink']}>{item.label}</span>
          <span class="text-[10px] text-taupe tracking-widest">0{i + 1}</span>
        </a>
      ))}
    </nav>
    <div class="px-6 pb-10 grid grid-cols-2 gap-3 text-[11px] uppercase tracking-[0.2em] text-brand">
      <a href="/conta">Minha conta</a>
      <a href="/contato">Contacto</a>
      <a href="/sobre">A marca</a>
      <a href="/trocas">Trocas</a>
    </div>
  </div>
</div>

<style>
  .header-shell { color: var(--color-ink); background: rgba(255, 248, 248, 0.82); backdrop-filter: blur(16px) saturate(1.4); -webkit-backdrop-filter: blur(16px) saturate(1.4); border: 1px solid rgba(192, 57, 43, 0.12); }
  #site-header[data-transparent='true']:not(.is-scrolled) .header-shell { background: transparent; border-color: transparent; backdrop-filter: none; color: var(--color-bone); }
  #site-header[data-transparent='true']:not(.is-scrolled) img { filter: brightness(0) invert(1); }
  #site-header.is-scrolled .header-shell { box-shadow: var(--shadow-soft); }
  #site-header.is-hidden { transform: translateY(-120%); }
  .icon-btn { display: grid; place-items: center; min-width: 40px; height: 40px; border-radius: 999px; transition: background-color .3s; }
  .icon-btn:hover { background: rgba(192, 57, 43, 0.08); }
  .nav-link { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; font-weight: 500; position: relative; padding: .4rem 0; }
  .nav-link::after { content: ''; position: absolute; left: 50%; bottom: -2px; width: 4px; height: 4px; border-radius: 99px; background: var(--color-brand); transform: translateX(-50%) scale(0); transition: transform .4s var(--ease-silk); }
  .nav-link:hover::after, .nav-link.is-active::after { transform: translateX(-50%) scale(1); }
  .nav-accent { color: var(--color-gold); }
  .badge-dot { position: absolute; top: 2px; right: 0; min-width: 17px; height: 17px; padding: 0 4px; border-radius: 99px; background: var(--color-brand); color: var(--color-bone); font-size: 10px; font-weight: 600; display: grid; place-items: center; }
  .badge-dot.hidden { display: none; }
  #mobile-menu.is-open { pointer-events: auto; }
  #mobile-menu.is-open [data-menu-backdrop] { opacity: 1; }
  #mobile-menu.is-open [data-menu-panel] { translate: none; }
  .menu-item { opacity: 0; transform: translateX(-16px); transition: opacity .6s var(--ease-silk), transform .6s var(--ease-silk); transition-delay: calc(var(--i) * 45ms + 150ms); }
  #mobile-menu.is-open .menu-item { opacity: 1; transform: none; }
</style>

<script>
  import { cartCount, cartOpen } from '../stores/cart';
  import { wishlist } from '../stores/wishlist';

  const setBadge = (el: Element | null, n: number): void => {
    if (!el) return;
    el.textContent = String(n);
    el.classList.toggle('hidden', n === 0);
  };

  let lastY = 0;
  window.addEventListener('scroll', () => {
    const header = document.getElementById('site-header');
    if (!header) return;
    const y = window.scrollY;
    header.classList.toggle('is-scrolled', y > 40);
    header.classList.toggle('is-hidden', y > 400 && y > lastY + 4);
    if (y < lastY - 4) header.classList.remove('is-hidden');
    lastY = y;
  }, { passive: true });

  cartCount.subscribe((n) => setBadge(document.getElementById('cart-count'), n));
  wishlist.subscribe((l) => setBadge(document.querySelector('[data-wish-count]'), l.length));

  document.addEventListener('astro:page-load', () => {
    setBadge(document.getElementById('cart-count'), cartCount.get());
    setBadge(document.querySelector('[data-wish-count]'), wishlist.get().length);
    const menu = document.getElementById('mobile-menu');
    const toggle = document.getElementById('menu-toggle');
    const setMenu = (open: boolean): void => {
      menu?.classList.toggle('is-open', open);
      menu?.setAttribute('aria-hidden', String(!open));
      toggle?.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };
    toggle?.addEventListener('click', () => setMenu(true));
    document.getElementById('menu-close')?.addEventListener('click', () => setMenu(false));
    menu?.querySelector('[data-menu-backdrop]')?.addEventListener('click', () => setMenu(false));
    menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
    document.getElementById('cart-toggle')?.addEventListener('click', () => cartOpen.set(true));
    document.getElementById('site-header')?.classList.toggle('is-scrolled', window.scrollY > 40);
  });
</script>
