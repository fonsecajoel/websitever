---
import ProductCard from './ProductCard.astro';
import type { Product } from '../lib/types';

interface Props { products: Product[] }
const { products } = Astro.props;
const sizes = [...new Set(products.flatMap((p) => p.sizes.filter((s) => s.stock > 0).map((s) => s.label)))].sort((a, b) => Number(a) - Number(b) || a.localeCompare(b));
const colors = [...new Map(products.flatMap((p) => p.colors).map((c) => [c.name, c])).values()];
---

<div data-catalog>
  <div class="sticky top-[84px] z-20 py-3 mb-8">
    <div class="glass rounded-full px-3 md:px-4 py-2 flex items-center gap-2 overflow-x-auto no-scrollbar shadow-soft">
      <span class="eyebrow shrink-0 pl-2 pr-1" data-count-label>{products.length} peças</span>
      <span class="w-px h-6 bg-taupe/30 shrink-0"></span>
      {sizes.map((s) => <button type="button" class="filter-pill" data-filter-size={s}>{s}</button>)}
      {colors.length > 0 && <span class="w-px h-6 bg-taupe/30 shrink-0"></span>}
      {colors.map((c) => <button type="button" class="filter-dot" data-filter-color={c.name} title={c.name} style={`background:${c.hex}`} aria-label={c.name}></button>)}
      <span class="flex-1"></span>
      <select data-sort class="shrink-0 bg-transparent text-[11px] uppercase tracking-[0.18em] text-ink pr-2 outline-none cursor-pointer" aria-label="Ordenar">
        <option value="featured">Destaques</option>
        <option value="new">Novidades</option>
        <option value="price-asc">Preço ↑</option>
        <option value="price-desc">Preço ↓</option>
      </select>
    </div>
  </div>

  <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-4 gap-y-12 md:gap-x-6" data-grid>
    {products.map((p, i) => (
      <div class="reveal" style={`transition-delay:${(i % 4) * 70}ms`} data-item data-price={p.price} data-new={p.isNew ? '1' : '0'} data-order={i}
        data-sizes={p.sizes.filter((s) => s.stock > 0).map((s) => s.label).join(',')} data-colors={p.colors.map((c) => c.name).join(',')}>
        <ProductCard product={p} priority={i < 4} index={i} />
      </div>
    ))}
  </div>
  <p data-empty class="hidden text-center text-mocha py-20">Nenhuma peça com estes filtros. <button type="button" class="link-underline text-brand" data-clear>Limpar filtros</button></p>
</div>

<style>
  .filter-pill { flex-shrink: 0; min-width: 38px; height: 34px; padding: 0 .7rem; border-radius: 999px; font-size: 12px; border: 1px solid rgba(196, 149, 142, .4); transition: all .3s; }
  .filter-pill:hover { border-color: var(--color-ink); }
  .filter-pill.is-on { background: var(--color-ink); color: var(--color-bone); border-color: var(--color-ink); }
  .filter-dot { flex-shrink: 0; width: 26px; height: 26px; border-radius: 999px; box-shadow: 0 0 0 1px rgba(196, 149, 142, .5); transition: box-shadow .3s; }
  .filter-dot.is-on { box-shadow: 0 0 0 2px var(--color-bone), 0 0 0 4px var(--color-brand); }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-catalog]');
    if (!root) return;
    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    const items = Array.from(grid.querySelectorAll<HTMLElement>('[data-item]'));
    const selSizes = new Set<string>();
    const selColors = new Set<string>();
    const sort = root.querySelector<HTMLSelectElement>('[data-sort]')!;

    const apply = (): void => {
      let visible = 0;
      for (const it of items) {
        const sizes = (it.dataset.sizes ?? '').split(',');
        const colors = (it.dataset.colors ?? '').split(',');
        const ok = (selSizes.size === 0 || sizes.some((s) => selSizes.has(s))) && (selColors.size === 0 || colors.some((c) => selColors.has(c)));
        it.classList.toggle('hidden', !ok);
        if (ok) { visible++; it.classList.add('is-visible'); }
      }
      const key = sort.value;
      const sorted = [...items].sort((a, b) => {
        const pa = Number(a.dataset.price), pb = Number(b.dataset.price);
        if (key === 'price-asc') return pa - pb;
        if (key === 'price-desc') return pb - pa;
        if (key === 'new') return Number(b.dataset.new) - Number(a.dataset.new) || Number(a.dataset.order) - Number(b.dataset.order);
        return Number(a.dataset.order) - Number(b.dataset.order);
      });
      sorted.forEach((el) => grid.appendChild(el));
      root.querySelector('[data-count-label]')!.textContent = `${visible} peça${visible === 1 ? '' : 's'}`;
      root.querySelector('[data-empty]')!.classList.toggle('hidden', visible > 0);
    };

    root.querySelectorAll<HTMLButtonElement>('[data-filter-size]').forEach((b) => b.addEventListener('click', () => {
      const v = b.dataset.filterSize!; selSizes.has(v) ? selSizes.delete(v) : selSizes.add(v); b.classList.toggle('is-on'); apply();
    }));
    root.querySelectorAll<HTMLButtonElement>('[data-filter-color]').forEach((b) => b.addEventListener('click', () => {
      const v = b.dataset.filterColor!; selColors.has(v) ? selColors.delete(v) : selColors.add(v); b.classList.toggle('is-on'); apply();
    }));
    root.querySelector('[data-clear]')?.addEventListener('click', () => {
      selSizes.clear(); selColors.clear(); root.querySelectorAll('.is-on').forEach((e) => e.classList.remove('is-on')); apply();
    });
    sort.addEventListener('change', apply);
  });
</script>
